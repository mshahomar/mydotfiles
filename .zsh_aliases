##### My Custom Functions ######
#!/bin/bash

kpodinfo() {
    # Get all nodes info in one call
    local node_info=$(kubectl get nodes -o json)
    # Get cluster version
    local cluster_version=$(kubectl version -o json | jq -r '.serverVersion.gitVersion')
    # Get all pods with node info
    kubectl get pods -A -o custom-columns=NAME:.metadata.name,NODE:.spec.nodeName --no-headers | \
    while read pod_name node_name; do
        local kernel_version=$(echo "$node_info" | jq -r ".items[] | select(.metadata.name == \"$node_name\") | .status.nodeInfo.kernelVersion")
        local node_creation=$(echo "$node_info" | jq -r ".items[] | select(.metadata.name == \"$node_name\") | .metadata.creationTimestamp")
        local node_age=$(date -d "$node_creation" +"%d days %H hours %M minutes")
        echo "Pod: $pod_name, Node: $node_name, Node Age: $node_age, Kernel Version: $kernel_version, Cluster Version: $cluster_version"
    done
}

## To list Security Hub findings because my previous boss was a nut job:
aws_sh_get_findings() {
    aws securityhub get-findings --filters '{"ComplianceStatus": [{"Value": "FAILED","Comparison": "EQUALS"}]}' \
    | jq -r '.Findings[] | [.Severity.Label, .Id, .Resources[0].Id] | @csv' \
    | sed '1iSeverity,ID,AffectedResource'
}

## To list findings from ECR enhanced scanning and reported in AWS Inspector:
aws_inspector_list_findings() {
    IMAGE_SHA="$1"
    OUTPUT_CSV="$2.csv"

    if [ "$#" -ne 2 ]; then
        echo "Usage: aws_inspector_list_findings <sha256:TARGET IMAGE SHA256> <FILE NAME TO EXPORT TO>"
        #exit 1
    else
        aws inspector2 list-findings \
          --filter "{\"ecrImageHash\":[{\"comparison\":\"EQUALS\",\"value\":\"$IMAGE_SHA\"}]}" \
          --query "findings[].{
            Title: title,
            Severity: severity,
            Description: description,
            VulnerabilityId: packageVulnerabilityDetails.vulnerabilityId || 'N/A',
            PackageManager: packageVulnerabilityDetails.vulnerablePackages[0].packageManager || 'N/A',
            VulnerablePackages: join(', ', packageVulnerabilityDetails.vulnerablePackages[].name || ['N/A']),
            FilePath: join(', ', packageVulnerabilityDetails.vulnerablePackages[].filePath || ['N/A'])
          }" \
          --no-paginate --output json --profile my-profile-1 --region ap-southeast-2 | \
        jq -r '
          sort_by(.Severity) |
          (.[0] | keys_unsorted) as $keys |
          $keys, map([.[ $keys[] ]])[] |
          @csv
        ' > $OUTPUT_CSV
    fi
}

## To spoof CICD components in /etc/hosts for LB not publicly available:
aws_get_devops_ip() {
    echo "Enter which CI/CD LoadBalancer IP to lookup (gitlab/jenkins/nexus/sonarqube/selenium):"
    # -r to prevent backslash interpretation
    read -r serviceName

    validServices=("gitlab" "jenkins" "nexus" "sonarqube" "selenium")
    if [[ ! " ${validServices[@]} " =~ " ${serviceName} " ]]; then
        echo "Error: Invalid service name. Please choose from ${validServices[*]}"
        return 1
    fi

    # special case for sonarqube the name is 'sonarqub'. Don't blame me, blame AWS ;)
    if [[ "$serviceName" == "sonarqube" ]]; then
        serviceName="sonarqub"
        echo ">>Looking up ${serviceName}"
    else
        echo "Looking up ${serviceName}"
    fi

    # From below aws cli command grab only values that matches lbIP
    lb=$(aws elbv2 describe-load-balancers --profile my-profile-1 --region ap-southeast-2 --query "LoadBalancers[?contains(DNSName, '${serviceName}')].DNSName" --output text)

    if [[ $? -eq 255 ]]; then
        echo "Please run aws sso login --sso-session <your-session-name>"
        return 1
    fi

    if [[ -z "${lb}" ]]; then
        echo "Error: No load balancer found for ${serviceName}"
        return 1
    fi

    # Get IP address
    lbIP=$(dig +short ${lb} |head -n 1)

    if [[ -z "${lbIP}" ]]; then
        echo "Error: Could not resolve IP address for ${lb}"
        return 1
    fi

    echo "${serviceName} LoadBalancer IP: ${lbIP}"
}

## To get latest tag from a specified ECR repo
aws_ecr_get_latest() {
    echo "Enter name of ECR repository: "
    read -r targetRepo

    validRepos=($(aws ecr describe-repositories --profile my-profile-1 --region ap-southeast-2 --query 'repositories[].repositoryName' --output text))
    found=false
    for repo in "${validRepos[@]}"; do
        if [[ "$repo" == "$targetRepo" ]]; then
            found=true
            break
        fi
    done

    if [[ "$found" == true ]]; then
        echo "Repository found!"
        aws ecr describe-images \
            --repository-name "$targetRepo" \
            --profile my-profile-1 \
            --region ap-southeast-2 \
            --query 'imageDetails[?not_null(imageTags[0])].{Tag: imageTags[0], PushedDate: imagePushedAt}' \
            --output json | \
        jq 'group_by(.Tag | split("-")[0]) | map(max_by(.PushedDate)) | .[].Tag'
    else
        echo "Repository $targetRepo is not found!"
        return 1
    fi
}
