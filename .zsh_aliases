# Interactive global find and replace function using 'sd'
smart_replace() {
    # 1. Check if sd is installed
    if ! command -v sd &> /dev/null; then
        echo "❌ 'sd' command is not installed."
        echo -n "❓ Would you like to install it now using 'brew install sd'? (y/n): "
        read -r install_resp
        
        if [[ "$install_resp" =~ ^[Yy]$ ]]; then
            echo "⏳ Installing sd via Homebrew..."
            brew install sd
            
            if ! command -v sd &> /dev/null; then
                echo "❌ Homebrew installation failed. Exiting."
                return 1
            fi
        else
            echo "🛑 Installation declined. Exiting function."
            return 1
        fi
    fi

    # 2. Get user input for search and replace targets
    echo -n "🔍 Enter the string to SEARCH for: "
    read -r search_str
    if [[ -z "$search_str" ]]; then
        echo "❌ Search string cannot be empty. Exiting."
        return 1
    fi

    echo -n "✏️  Enter the REPLACEMENT string: "
    read -r replace_str

    # 3. Find files matching the search string
    local files=(${(f)"$(grep -rl "$search_str" . 2>/dev/null)"})

    if [[ ${#files[@]} -eq 0 || -z "${files}" ]]; then
        echo "🎉 No matching files found containing '$search_str'."
        return 0
    fi

    echo "\nFound matches in ${#files[@]} file(s). Starting confirmation loop..."

    # 4. Interactive loop over files
    for file in "${files[@]}"; do
        [[ -z "$file" ]] && continue

        echo "\n----------------------------------------"
        echo "📄 File: $file"
        echo "🔍 Preview of changes:"
        
        # Display the visual diff layout using sd
        sd "$search_str" "$replace_str" "$file" --preview
        
        echo -n "⚠️  Apply these changes to this file? (y/n): "
        read -r response
        if [[ "$response" =~ ^[Yy]$ ]]; then
            sd "$search_str" "$replace_str" "$file"
            echo "✅ Updated!"
        else
            echo "⏭️  Skipped."
        fi
    done
    echo "\n✨ Replacement process complete."
}

